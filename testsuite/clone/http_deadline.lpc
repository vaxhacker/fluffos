// Timers armed after LPC has run longer than their timeouts in one execution,
// each in its own pass so neither fix covers for the other.
// tools/test_http_deadline.py reads the three lines this prints.
inherit "/single/master";

int port, failed;

mixed valid_http(string url, object caller) { return caller == this_object(); }

void drift_done(int ms) {
  debug_message(sprintf("DEADLINE TICK ms=%d\n", ms));
  shutdown(failed);
}

void start_ticks() { new("/clone/tick_burner")->start(); }

void callout_fired(int armed) {
  debug_message(sprintf("DEADLINE CALLOUT ms=%d\n", (perf_counter_ns() - armed) / 1000000));
  call_out_walltime((: start_ticks :), 0.1);
}

// 2 s of LPC, then a 0.5 s call_out_walltime and nothing else in this pass.
void burn_then_callout() {
  int start = perf_counter_ns();
  while (perf_counter_ns() - start < 2000000000);
  call_out_walltime("callout_fired", 0.5, perf_counter_ns());
}

// 2 s of LPC, then an http_request with a 1000 ms timeout and nothing else in this pass.
void burn_then_request() {
  int start = perf_counter_ns();
  while (perf_counter_ns() - start < 2000000000);
  promise_then(http_request(sprintf("http://127.0.0.1:%d/ok", port), ([ "timeout": 1000 ])),
    function(mapping r) {
      debug_message(sprintf("DEADLINE HTTP status=%d\n", r["status"]));
      call_out_walltime((: burn_then_callout :), 0.1);
    }, function(mixed reason) {
      debug_message(sprintf("DEADLINE HTTP rejected: %O\n", reason));
      failed = 1;
      call_out_walltime((: burn_then_callout :), 0.1);
    });
}

void flag(string arg) {
  if (sscanf(arg, "deadline:%d", port) != 1) {
    shutdown(2);
    return;
  }
  call_out_walltime((: burn_then_request :), 0.1);
}
